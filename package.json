{
	"name": "wp-parsely",
	"version": "3.26.1",
	"private": true,
	"description": "The Parse.ly plugin facilitates real-time and historical analytics to your content through a platform designed and built for digital publishing.",
	"author": "parsely, hbbtstar, jblz, mikeyarce, GaryJ, parsely_mike, acicovic, mehmoodak, vaurdan",
	"license": "GPL-2.0-or-later",
	"keywords": [
		"analytics",
		"parse.ly",
		"parsely",
		"parsley"
	],
	"homepage": "https://github.com/Parsely/wp-parsely",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/Parsely/wp-parsely.git"
	},
	"bugs": {
		"url": "https://github.com/Parsely/wp-parsely/issues"
	},
	"engines": {
		"node": ">=22.15.0",
		"npm": ">=10.9.2"
	},
	"directories": {
		"test": "tests"
	},
	"files": [
		"build/",
		"src/",
		"uninstall.php",
		"wp-parsely.php"
	],
	"browserslist": [
		"defaults"
	],
	"dependencies": {
		"@types/js-cookie": "^3.0.6",
		"@wordpress/dom-ready": "^5.2.0",
		"js-cookie": "^3.0.8",
		"lodash.debounce": "^4.0.8"
	},
	"devDependencies": {
		"@playwright/test": "^1.65.1",
		"@testing-library/jest-dom": "^8.0.0",
		"@testing-library/react": "^16.3.3",
		"@types/jest": "^30.0.0",
		"@types/js-cookie": "^3.0.6",
		"@types/lodash.debounce": "^4.0.9",
		"@types/react-router": "^5.1.20",
		"@types/wordpress__wordcount": "^2.4.5",
		"@wordpress/api-fetch": "8.2",
		"@wordpress/babel-preset-default": "^10.2.0",
		"@wordpress/block-editor": "^20.1.0",
		"@wordpress/blocks": "^17.1.0",
		"@wordpress/components": "^45.0.0",
		"@wordpress/compose": "^9.2.0",
		"@wordpress/core-data": "^9.2.0",
		"@wordpress/data": "^11.1.0",
		"@wordpress/e2e-test-utils-playwright": "^3.3.0",
		"@wordpress/editor": "^16.2.0",
		"@wordpress/element": "^10.1.0",
		"@wordpress/env": "^12.2.0",
		"@wordpress/eslint-plugin": "^28.1.0",
		"@wordpress/hooks": "^5.1.0",
		"@wordpress/i18n": "^7.1.0",
		"@wordpress/icons": "^21.0.0",
		"@wordpress/notices": "^6.1.0",
		"@wordpress/plugins": "^8.1.0",
		"@wordpress/scripts": "^27.9.0",
		"@wordpress/url": "^5.1.0",
		"@wordpress/wordcount": "^5.1.0",
		"concurrently": "^10.0.7",
		"eslint": "^10.15.0",
		"eslint-plugin-jest": "^29.17.1",
		"husky": "^9.1.7",
		"lodash.debounce": "^4.0.8",
		"prettier": "^3.10.1",
		"react-router": "^7.18.6",
		"ts-loader": "^9.6.2",
		"typescript": "^5.9.3",
		"typescript-eslint": "^8.73.0"
	},
	"devDependenciesComments": {
		"@wordpress/scripts": "Don't upgrade to v28 or greater until the plugin requires WordPress 6.6. See https://github.com/WordPress/gutenberg/pull/62265/files"
	},
	"overrides": {
		"@wordpress/eslint-plugin@^28.1.0": {
			"eslint-plugin-import": {
				"eslint": "^10.0.0"
			},
			"eslint-plugin-jsx-a11y": {
				"eslint": "^10.0.0"
			},
			"eslint-plugin-react": {
				"eslint": "^10.0.0"
			}
		},
		"del": "^6.1.1",
		"express": "^4.22.0",
		"glob": "^10.5.0",
		"isomorphic-git": "^1.44.13",
		"js-yaml@^3": "3.15.2",
		"node-forge": "^1.4.3",
		"puppeteer-core": "^23.1.0",
		"qs": "^6.14.1"
	},
	"overridesComments": {
		"@wordpress/eslint-plugin@^28.1.0": "Allows ESLint 10. Keep until eslint-plugin-import, eslint-plugin-jsx-a11y and eslint-plugin-react support it.",
		"del": "Fixes `npm run build`.",
		"express": "Security update to v4.22.0 or later. Keep until @wordpress/scripts gets upgraded.",
		"glob": "Security update to v10.5.0 or later.",
		"isomorphic-git": "Update to a current release. Keep until @wp-playground/storage (from @wordpress/env) stops pinning an older one.",
		"js-yaml@^3": "Security update to v3.15.2. Keep until @wordpress/scripts gets upgraded.",
		"node-forge": "Security update to v1.4.3 or later. Keep until @wordpress/scripts gets upgraded.",
		"puppeteer-core": "Security update to v23.1.0 or later. Keep until @wordpress/scripts gets upgraded.",
		"qs": "Security update to v6.14.1 or later. Keep until @wordpress/scripts gets upgraded."
	},
	"scripts": {
		"build": "wp-scripts build",
		"dev:logs": "wp-env logs",
		"dev:start": "wp-env start",
		"dev:stop": "wp-env stop",
		"lint": "concurrently \"npm:lint:*\"",
		"lint:composer": "composer lint",
		"lint:css": "wp-scripts lint-style",
		"lint:js": "eslint .",
		"lint:pkg-json": "wp-scripts lint-pkg-json",
		"plugin-zip": "wp-scripts plugin-zip",
		"prepare": "husky",
		"start": "wp-scripts start",
		"test": "npm run test:unit",
		"test:e2e": "wp-scripts test-playwright --config tests/e2e/playwright.config.ts",
		"test:e2e:debug": "wp-scripts test-playwright --config tests/e2e/playwright.config.ts --ui",
		"test:e2e:help": "wp-scripts test-e2e --help",
		"test:unit": "wp-scripts test-unit-js",
		"test:unit:debug": "wp-scripts --inspect-brk test-unit-js --runInBand --no-cache",
		"test:unit:help": "wp-scripts test-unit-js --help",
		"test:unit:watch": "wp-scripts test-unit-js --watch",
		"wp-env": "wp-env"
	}
}
